{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node", "mocha", "@wdio/globals/types"]
  },
  "include": ["config/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
