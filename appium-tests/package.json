{
  "name": "fingenius-appium-tests",
  "version": "1.0.0",
  "description": "Appium + WebdriverIO automation tests for FinGenius Android app",
  "private": true,
  "scripts": {
    "test": "npx wdio run config/wdio.conf.ts",
    "test:auth": "npx wdio run config/wdio.conf.ts --spec test/specs/01-authentication.spec.ts",
    "test:dashboard": "npx wdio run config/wdio.conf.ts --spec test/specs/02-dashboard.spec.ts",
    "test:expense": "npx wdio run config/wdio.conf.ts --spec test/specs/03-expense-management.spec.ts",
    "test:receipt": "npx wdio run config/wdio.conf.ts --spec test/specs/04-receipt-scanning.spec.ts",
    "test:history": "npx wdio run config/wdio.conf.ts --spec test/specs/05-expense-history.spec.ts",
    "test:navigation": "npx wdio run config/wdio.conf.ts --spec test/specs/06-navigation.spec.ts",
    "test:network": "npx wdio run config/wdio.conf.ts --spec test/specs/07-network-error-handling.spec.ts",
    "report": "node test/helpers/generate-report.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/junit-reporter": "^9.31.2",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
