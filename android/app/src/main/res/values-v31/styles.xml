<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_splash_background</item>
        <!-- Use the complete branded mark. The foreground-only adaptive asset
             disappeared during Android 12's native splash transition and left
             the solid green frame visible in the recording. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
